(define (domain scanalyzer3d)
  (:requirements :strips :typing)
  (:types car segment - object)
  (:predicates
    (CYCLE-2 ?s1 ?s2 - segment)
    (CYCLE-2-WITH-ANALYSIS ?s1 ?s2 - segment)
    (CYCLE-4 ?s1 ?s2 ?s3 ?s4 - segment)
    (CYCLE-4-WITH-ANALYSIS ?s1 ?s2 ?s3 ?s4 - segment)
    (on ?c - car ?s - segment)
    (analyzed ?c - car)
  )
  (:action analyze-cycle-2
    :parameters (?c1 ?c2 - car ?s1 ?s2 - segment)
    :precondition (and
      (CYCLE-2-WITH-ANALYSIS ?s1 ?s2)
      (on ?c1 ?s1)
      (on ?c2 ?s2)
    )
    :effect (and
      (not (on ?c1 ?s1))
      (not (on ?c2 ?s2))
      (on ?c1 ?s2)
      (on ?c2 ?s1)
      (analyzed ?c1)
    )
  )
  (:action analyze-cycle-4
    :parameters (?c1 ?c2 ?c3 ?c4 - car ?s1 ?s2 ?s3 ?s4 - segment)
    :precondition (and
      (CYCLE-4-WITH-ANALYSIS ?s1 ?s2 ?s3 ?s4)
      (on ?c1 ?s1)
      (on ?c2 ?s2)
      (on ?c3 ?s3)
      (on ?c4 ?s4)
    )
    :effect (and
      (not (on ?c1 ?s1))
      (not (on ?c2 ?s2))
      (not (on ?c3 ?s3))
      (not (on ?c4 ?s4))
      (on ?c1 ?s4)
      (on ?c2 ?s1)
      (on ?c3 ?s2)
      (on ?c4 ?s3)
      (analyzed ?c1)
    )
  )
  (:action rotate-cycle-2
    :parameters (?c1 ?c2 - car ?s1 ?s2 - segment)
    :precondition (and
      (CYCLE-2 ?s1 ?s2)
      (on ?c1 ?s1)
      (on ?c2 ?s2)
    )
    :effect (and
      (not (on ?c1 ?s1))
      (not (on ?c2 ?s2))
      (on ?c1 ?s2)
      (on ?c2 ?s1)
    )
  )
  (:action rotate-cycle-4
    :parameters (?c1 ?c2 ?c3 ?c4 - car ?s1 ?s2 ?s3 ?s4 - segment)
    :precondition (and
      (CYCLE-4 ?s1 ?s2 ?s3 ?s4)
      (on ?c1 ?s1)
      (on ?c2 ?s2)
      (on ?c3 ?s3)
      (on ?c4 ?s4)
    )
    :effect (and
      (not (on ?c1 ?s1))
      (not (on ?c2 ?s2))
      (not (on ?c3 ?s3))
      (not (on ?c4 ?s4))
      (on ?c1 ?s4)
      (on ?c2 ?s1)
      (on ?c3 ?s2)
      (on ?c4 ?s3)
    )
  )
)
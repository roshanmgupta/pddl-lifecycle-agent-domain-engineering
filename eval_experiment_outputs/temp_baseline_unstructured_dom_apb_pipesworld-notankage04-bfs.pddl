(define (domain pipesworld-notankage04-bfs)
  (:requirements :strips :typing)
  (:types pipe area product batch-atom object)
  (:predicates
    (normal ?p - pipe)
    (being-push-updated ?p - pipe)
    (being-pop-updated ?p - pipe)
    (unitary ?p - pipe)
    (connect ?a1 - area ?a2 - area ?p - pipe)
    (on ?b - batch-atom ?a - area)
    (first-in ?b - batch-atom ?p - pipe)
    (last-in ?b - batch-atom ?p - pipe)
    (follows ?b1 - batch-atom ?b2 - batch-atom)
    (product-of ?b - batch-atom ?p - product)
    (may-interface ?p1 - product ?p2 - product)
  )
  (:action push-start
    :parameters (?p - pipe ?b1 - batch-atom ?a1 - area ?a2 - area ?b2 - batch-atom ?pr1 - product ?pr2 - product)
    :precondition (and (normal ?p) (first-in ?b2 ?p) (connect ?a1 ?a2 ?p) (on ?b1 ?a1) (not (unitary ?p)) (product-of ?b1 ?pr1) (product-of ?b2 ?pr2) (may-interface ?pr1 ?pr2))
    :effect (and (being-push-updated ?p) (first-in ?b1 ?p) (follows ?b2 ?b1) (not (normal ?p)) (not (first-in ?b2 ?p)) (not (on ?b1 ?a1)))
  )
  (:action push-end
    :parameters (?p - pipe ?a1 - area ?a2 - area ?b1 - batch-atom ?b2 - batch-atom)
    :precondition (and (being-push-updated ?p) (last-in ?b1 ?p) (connect ?a1 ?a2 ?p) (not (unitary ?p)) (follows ?b1 ?b2))
    :effect (and (normal ?p) (last-in ?b2 ?p) (on ?b1 ?a2) (not (being-push-updated ?p)) (not (follows ?b1 ?b2)) (not (last-in ?b1 ?p)))
  )
  (:action pop-start
    :parameters (?p - pipe ?a1 - area ?a2 - area ?b1 - batch-atom ?b2 - batch-atom ?pr1 - product ?pr2 - product)
    :precondition (and (normal ?p) (last-in ?b2 ?p) (connect ?a1 ?a2 ?p) (on ?b1 ?a2) (not (unitary ?p)) (product-of ?b1 ?pr1) (product-of ?b2 ?pr2) (may-interface ?pr1 ?pr2))
    :effect (and (being-pop-updated ?p) (last-in ?b1 ?p) (follows ?b1 ?b2) (not (normal ?p)) (not (last-in ?b2 ?p)) (not (on ?b1 ?a2)))
  )
  (:action pop-end
    :parameters (?p - pipe ?a1 - area ?a2 - area ?b1 - batch-atom ?b2 - batch-atom)
    :precondition (and (being-pop-updated ?p) (first-in ?b1 ?p) (connect ?a1 ?a2 ?p) (not (unitary ?p)) (follows ?b2 ?b1))
    :effect (and (normal ?p) (first-in ?b2 ?p) (on ?b1 ?a1) (not (being-pop-updated ?p)) (not (follows ?b2 ?b1)) (not (first-in ?b1 ?p)))
  )
  (:action push-unitary
    :parameters (?p - pipe ?b1 - batch-atom ?a1 - area ?a2 - area ?b2 - batch-atom ?pr1 - product ?pr2 - product)
    :precondition (and (first-in ?b2 ?p) (connect ?a1 ?a2 ?p) (on ?b1 ?a1) (unitary ?p) (product-of ?b1 ?pr1) (product-of ?b2 ?pr2) (may-interface ?pr1 ?pr2))
    :effect (and (first-in ?b1 ?p) (last-in ?b1 ?p) (on ?b2 ?a2) (not (first-in ?b2 ?p)) (not (last-in ?b2 ?p)) (not (on ?b1 ?a1)))
  )
  (:action pop-unitary
    :parameters (?p - pipe ?b1 - batch-atom ?a1 - area ?a2 - area ?b2 - batch-atom ?pr1 - product ?pr2 - product)
    :precondition (and (last-in ?b2 ?p) (connect ?a1 ?a2 ?p) (on ?b1 ?a2) (unitary ?p) (product-of ?b1 ?pr1) (product-of ?b2 ?pr2) (may-interface ?pr1 ?pr2))
    :effect (and (last-in ?b1 ?p) (first-in ?b1 ?p) (on ?b2 ?a1) (not (last-in ?b2 ?p)) (not (first-in ?b2 ?p)) (not (on ?b1 ?a2)))
  )
)
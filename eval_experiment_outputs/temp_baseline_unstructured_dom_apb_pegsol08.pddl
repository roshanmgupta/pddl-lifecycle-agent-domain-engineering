(define (domain pegsol08)
  (:requirements :strips :typing)
  (:types location)
  (:predicates
    (in-line ?a ?b ?c - location)
    (occupied ?loc - location)
    (free ?loc - location)
    (move-ended)
    (last-visited ?loc - location)
  )
  (:action jump-new-move
    :parameters (?a ?b ?c - location)
    :precondition (and
      (move-ended)
      (in-line ?a ?b ?c)
      (occupied ?a)
      (occupied ?b)
      (free ?c)
    )
    :effect (and
      (not (move-ended))
      (not (occupied ?a))
      (not (occupied ?b))
      (occupied ?c)
      (last-visited ?c)
      (not (free ?c))
    )
  )
  (:action continue-jump
    :parameters (?a ?b ?c - location)
    :precondition (and
      (last-visited ?a)
      (in-line ?a ?b ?c)
      (occupied ?a)
      (occupied ?b)
      (free ?c)
    )
    :effect (and
      (not (occupied ?a))
      (not (occupied ?b))
      (occupied ?c)
      (last-visited ?c)
      (not (free ?c))
      (not (last-visited ?a))
    )
  )
  (:action end-move
    :parameters (?a - location)
    :precondition (last-visited ?a)
    :effect (and
      (move-ended)
      (not (last-visited ?a))
    )
  )
)
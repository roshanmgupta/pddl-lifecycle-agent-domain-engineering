(define (domain rover-domain)
  (:requirements :strips :typing)
  (:types
    rover waypoint store camera mode lander objective - object
  )
  (:predicates
    (can-traverse ?r - rover ?from - waypoint ?to - waypoint)
    (available ?r - rover)
    (at ?r - rover ?w - waypoint)
    (visible ?from - waypoint ?to - waypoint)
    (at-soil-sample ?w - waypoint)
    (equipped-for-soil-analysis ?r - rover)
    (store-of ?s - store ?r - rover)
    (empty ?s - store)
    (full ?s - store)
    (has-soil-analysis ?r - rover ?w - waypoint)
    (at-rock-sample ?w - waypoint)
    (equipped-for-rock-analysis ?r - rover)
    (has-rock-analysis ?r - rover ?w - waypoint)
    (equipped-for-imaging ?r - rover)
    (calibration-target ?c - camera ?o - objective)
    (on-board ?c - camera ?r - rover)
    (calibrated-to ?c - camera ?r - rover)
    (supports ?c - camera ?m - mode)
    (has-image ?r - rover ?o - objective ?m - mode)
    (at-lander ?l - lander ?w - waypoint)
    (channel-free ?l - lander)
    (communicated-soil-data ?w - waypoint)
    (communicated-rock-data ?w - waypoint)
    (communicated-image-data ?o - objective ?m - mode)
  )
  (:action navigate
    :parameters (?r - rover ?from - waypoint ?to - waypoint)
    :precondition (and (can-traverse ?r ?from ?to) (available ?r) (at ?r ?from) (visible ?from ?to))
    :effect (and (at ?r ?to) (not (at ?r ?from)))
  )
  (:action sample-soil
    :parameters (?r - rover ?w - waypoint ?s - store)
    :precondition (and (at ?r ?w) (at-soil-sample ?w) (equipped-for-soil-analysis ?r) (store-of ?s ?r) (empty ?s))
    :effect (and (full ?s) (has-soil-analysis ?r ?w) (not (empty ?s)) (not (at-soil-sample ?w)))
  )
  (:action sample-rock
    :parameters (?r - rover ?w - waypoint ?s - store)
    :precondition (and (at ?r ?w) (at-rock-sample ?w) (equipped-for-rock-analysis ?r) (store-of ?s ?r) (empty ?s))
    :effect (and (full ?s) (has-rock-analysis ?r ?w) (not (empty ?s)) (not (at-rock-sample ?w)))
  )
  (:action drop-contents
    :parameters (?r - rover ?s - store)
    :precondition (and (store-of ?s ?r) (full ?s))
    :effect (and (empty ?s) (not (full ?s)))
  )
  (:action calibrate
    :parameters (?r - rover ?c - camera ?o - objective ?w - waypoint)
    :precondition (and (equipped-for-imaging ?r) (calibration-target ?c ?o) (at ?r ?w) (visible ?w ?o) (on-board ?c ?r))
    :effect (and (calibrated-to ?c ?r))
  )
  (:action take-image
    :parameters (?r - rover ?w - waypoint ?o - objective ?c - camera ?m - mode)
    :precondition (and (calibrated-to ?c ?r) (on-board ?c ?r) (equipped-for-imaging ?r) (supports ?c ?m) (visible ?w ?o) (at ?r ?w))
    :effect (and (has-image ?r ?o ?m) (not (calibrated-to ?c ?r)))
  )
  (:action communicate-soil-data
    :parameters (?r - rover ?d - waypoint ?l - lander ?e - waypoint ?w - waypoint)
    :precondition (and (at ?r ?d) (at-lander ?l ?e) (has-soil-analysis ?r ?w) (visible ?d ?e) (available ?r) (channel-free ?l))
    :effect (and (channel-free ?l) (communicated-soil-data ?w) (available ?r) (not (available ?r)) (not (channel-free ?l)))
  )
  (:action communicate-rock-data
    :parameters (?r - rover ?d - waypoint ?l - lander ?e - waypoint ?w - waypoint)
    :precondition (and (at ?r ?d) (at-lander ?l ?e) (has-rock-analysis ?r ?w) (visible ?d ?e) (available ?r) (channel-free ?l))
    :effect (and (channel-free ?l) (communicated-rock-data ?w) (available ?r) (not (available ?r)) (not (channel-free ?l)))
  )
  (:action communicate-image-data
    :parameters (?r - rover ?e - waypoint ?l - lander ?f - waypoint ?o - objective ?m - mode)
    :precondition (and (at ?r ?e) (at-lander ?l ?f) (has-image ?r ?o ?m) (visible ?e ?f) (available ?r) (channel-free ?l))
    :effect (and (channel-free ?l) (communicated-image-data ?o ?m) (available ?r) (not (available ?r)) (not (channel-free ?l)))
  )
)
(define (domain pegsolitaire-sequential)
    (:requirements :strips :typing)
    (:types location)
    (:predicates
        (free ?loc - location)
        (occupied ?loc - location)
        (IN-LINE ?loc1 ?loc2 ?loc3 - location)
        (move-ended)
        (last-visited ?loc - location)
    )
    (:action perform-jump-new-move
        :parameters (?A ?B ?C - location)
        :precondition (and
            (move-ended)
            (IN-LINE ?A ?B ?C)
            (occupied ?A)
            (occupied ?B)
            (free ?C)
        )
        :effect (and
            (not (move-ended))
            (not (occupied ?A))
            (not (occupied ?B))
            (occupied ?C)
            (last-visited ?C)
            (free ?A)
            (free ?B)
            (not (free ?C))
        )
    )
    (:action continue-jump
        :parameters (?A ?B ?C - location)
        :precondition (and
            (last-visited ?A)
            (IN-LINE ?A ?B ?C)
            (occupied ?A)
            (occupied ?B)
            (free ?C)
        )
        :effect (and
            (not (last-visited ?A))
            (not (occupied ?A))
            (not (occupied ?B))
            (occupied ?C)
            (last-visited ?C)
            (free ?A)
            (free ?B)
            (not (free ?C))
        )
    )
    (:action end-move
        :parameters (?A - location)
        :precondition (last-visited ?A)
        :effect (and
            (move-ended)
            (not (last-visited ?A))
        )
    )
)
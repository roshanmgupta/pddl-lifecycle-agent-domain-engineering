(define (domain parking)
  (:requirements :strips :typing)
  (:types car curb - object)
  (:predicates
    (at-curb ?c - car)
    (at-curb-num ?c - car ?cu - curb)
    (behind-car ?c1 - car ?c2 - car)
    (car-clear ?c - car)
    (curb-clear ?cu - curb)
  )
  (:action move-curb-to-curb
    :parameters (?a - car ?b - curb ?c - curb)
    :precondition (and (car-clear ?a) (curb-clear ?c) (at-curb-num ?a ?b))
    :effect (and (curb-clear ?b) (at-curb-num ?a ?c) (not (curb-clear ?c)) (not (at-curb-num ?a ?b)))
  )
  (:action move-curb-to-behind
    :parameters (?a - car ?b - curb ?c - car)
    :precondition (and (car-clear ?a) (car-clear ?c) (at-curb-num ?a ?b) (at-curb ?c))
    :effect (and (curb-clear ?b) (behind-car ?a ?c) (not (car-clear ?c)) (not (at-curb-num ?a ?b)) (not (at-curb ?a)))
  )
  (:action move-behind-to-curb
    :parameters (?a - car ?b - car ?c - curb)
    :precondition (and (car-clear ?a) (curb-clear ?c) (behind-car ?a ?b))
    :effect (and (car-clear ?b) (at-curb-num ?a ?c) (at-curb ?a) (not (curb-clear ?c)) (not (behind-car ?a ?b)))
  )
  (:action move-behind-to-behind
    :parameters (?a - car ?b - car ?c - car)
    :precondition (and (car-clear ?a) (car-clear ?c) (behind-car ?a ?b) (at-curb ?c))
    :effect (and (car-clear ?b) (behind-car ?a ?c) (not (car-clear ?c)) (not (behind-car ?a ?b)))
  )
)
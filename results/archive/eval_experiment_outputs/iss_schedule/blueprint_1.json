        "parameters": {
          "?a": "astronaut",
          "?d": "day",
          "?next_d": "day"
        },
        "preconditions": [
          "(current_day ?a ?d)",
          "(done_pre_sleep ?a ?d)",
          "(next_day ?d ?next_d)",
          "(not (done_sleep ?a ?d))"
        ],
        "effects": [

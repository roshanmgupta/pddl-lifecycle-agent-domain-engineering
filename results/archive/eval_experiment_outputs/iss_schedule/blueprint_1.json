        ],
        "effects": [
          "(task_completed ?t)"
        ]
      },
      {
        "action_name": "change_filter",
        "parameters": {
          "?a": "astronaut",
          "?t": "maintenance_task"
        },
        "preconditions": [
          "(task_assigned ?t ?a)",

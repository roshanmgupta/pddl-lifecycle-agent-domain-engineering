          "(thermal_loop_reconfigured ?t)"
        ]
      },
      {
        "action_name": "rpcm_swap_hardware",
        "parameters": {
          "?a": "astronaut",
          "?t": "maintenance_task"
        },
        "preconditions": [
          "(task_assigned ?t ?a)",
          "(is_rpcm_task ?t)",
          "(thermal_loop_reconfigured ?t)",
          "(not (hardware_swapped ?t))"
        ],
        "effects": [
          "(hardware_swapped ?t)"
        ]
      },
      {
        "action_name": "rpcm_reassemble_sleep_station",
        "parameters": {
          "?a": "astronaut",
          "?t": "maintenance_task"
        },
        "preconditions": [
          "(task_assigned ?t ?a)",
          "(is_rpcm_task ?t)",
          "(hardware_swapped ?t)",

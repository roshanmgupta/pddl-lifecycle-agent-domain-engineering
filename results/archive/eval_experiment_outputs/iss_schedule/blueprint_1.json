        ]
      },
      {
        "action_name": "eat_meal_3",
        "parameters": {
          "?a": "astronaut",
          "?d": "day"
        },
        "preconditions": [
          "(current_day ?a ?d)",
          "(done_exercise ?a ?d)",
          "(not (done_meal_3 ?a ?d))"
        ],
        "effects": [
          "(done_meal_3 ?a ?d)"
        ]
      },
      {
        "action_name": "perform_pre_sleep",

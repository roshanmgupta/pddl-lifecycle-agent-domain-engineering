          "?d": "day"
        },
        "preconditions": [
          "(current_day ?a ?d)",
          "(done_meal_1 ?a ?d)",
          "(not (done_planning ?a ?d))"
        ],
        "effects": [
          "(done_planning ?a ?d)"
        ]
      },
      {
        "action_name": "eat_meal_2",
        "parameters": {
          "?a": "astronaut",
          "?d": "day"
        },
        "preconditions": [
          "(current_day ?a ?d)",
          "(done_planning ?a ?d)",

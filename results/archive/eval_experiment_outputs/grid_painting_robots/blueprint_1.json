        },
        "preconditions": [
          "(at ?r ?from)",
          "(facing ?r ?d)",
          "(adjacent ?from ?to ?d)",
          "(clear ?to)",
          "(not (painted ?to))"
        ],
        "effects": [
          "(not (at ?r ?from))",
          "(at ?r ?to)",
          "(clear ?from)",
          "(not (clear ?to))"
        ]
      },
      {
        "action_name": "turn",
        "parameters": {
          "?r": "robot",
          "?old": "direction",
          "?new": "direction"
        },
        "preconditions": [
          "(facing ?r ?old)",
          "(not (= ?old ?new))"
        ],
        "effects": [
          "(not (facing ?r ?old))",
          "(facing ?r ?new)"
        ]
      },
      {
        "action_name": "spray_front",
        "parameters": {
          "?r": "robot",
          "?from": "tile",
          "?target": "tile",
          "?c": "color",
          "?d": "direction"
        },
        "preconditions": [
          "(at ?r ?from)",
          "(facing ?r ?d)",
          "(active_color ?r ?c)",
          "(adjacent ?from ?target ?d)",
          "(clear ?target)",
          "(not (painted ?target))"
        ],
        "effects": [
          "(painted ?target)",
          "(painted_with ?target ?c)"
        ]
      },
      {
        "action_name": "spray_behind",
        "parameters": {
          "?r": "robot",
          "?from": "tile",
          "?target": "tile",
          "?c": "color",
          "?d_front": "direction",
          "?d_behind": "direction"
        },
        "preconditions": [
          "(at ?r ?from)",
          "(facing ?r ?d_front)",
          "(active_color ?r ?c)",
          "(adjacent ?from ?target ?d_behind)",
          "(opposite ?d_front ?d_behind)",
          "(clear ?target)",
          "(not (painted ?target))"
        ],
        "effects": [
          "(painted ?target)",
          "(painted_with ?target ?c)"
        ]
      },
      {
        "action_name": "switch_color",
        "parameters": {
          "?r": "robot",
          "?t": "tile",
          "?old": "color",
          "?new": "color"
        },
        "preconditions": [
          "(at ?r ?t)",
          "(paint_station ?t)",
          "(active_color ?r ?old)",
          "(has_sprayer ?r ?new)",
          "(not (= ?old ?new))"
        ],
        "effects": [
          "(not (active_color ?r ?old))",
          "(active_color ?r ?new)"
        ]
      }
    ]
  },
